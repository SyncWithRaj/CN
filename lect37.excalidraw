    {
      "id": "5thyGDHrYqMruppCOmbHt",
      "type": "text",
      "x": 1246.1657698808008,
      "y": 9805.023232968104,
      "width": 560.955635833485,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOzl",
      "roundness": null,
      "seed": 1752047730,
      "version": 329,
      "versionNonce": 1872184302,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787142478546,
      "link": null,
      "locked": false,
      "text": "As discussed earlier in this video, if the client chooses\nNOT to use Huffman encoding the H bit will be 0, and the\nserver will NOT perform Huffman decoding",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As discussed earlier in this video, if the client chooses NOT to use Huffman encoding the H bit will be 0, and the server will NOT perform Huffman decoding",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jpm2JH_b_EaJzUV2ugl0v",
      "type": "text",
      "x": 1244.0201004695937,
      "y": 9915.555543521674,
      "width": 952.8038469320792,
      "height": 153.759765625,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOzm",
      "roundness": null,
      "seed": 682730542,
      "version": 446,
      "versionNonce": 1258960750,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787142466387,
      "link": null,
      "locked": false,
      "text": "IMP NOTE: Huffman codes are prefix-free, meaning the complete bit pattern of\none character can NEVER be the prefix of another. For example, if A = 010,\nthen B = 01011 is NOT ALLOWED, because the decoder wouldn't know whether\n010 is a complete character (A) or the beginning of 01011 (B) This property\nallows Huffman-encoded data to be decoded without caring about separators",
      "fontSize": 24.601562499999996,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IMP NOTE: Huffman codes are prefix-free, meaning the complete bit pattern of one character can NEVER be the prefix of another. For example, if A = 010, then B = 01011 is NOT ALLOWED, because the decoder wouldn't know whether 010 is a complete character (A) or the beginning of 01011 (B) This property allows Huffman-encoded data to be decoded without caring about separators",
      "autoResize": false,
      "lineHeight": 1.25
    },
