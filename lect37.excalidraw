    {
      "id": "8Rvsws4r85-uUlye6whaP",
      "type": "text",
      "x": -71.7144863390794,
      "y": 13148.760514920454,
      "width": 600.1595458984375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOxa",
