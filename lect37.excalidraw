    {
      "id": "-0jc3D7FkT7i6UgflHla7",
      "type": "text",
      "x": -859.1558959993827,
      "y": 10486.77906108363,
      "width": 3875.475830078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
