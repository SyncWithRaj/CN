    {
      "id": "N7ls-3pJKA8igDfgTmheH",
      "type": "text",
      "x": 1827.656598062782,
      "y": 3470.8903376383837,
      "width": 662.999999937218,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOye",
      "roundness": null,
      "seed": 1528099442,
      "version": 209,
      "versionNonce": 1293763566,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787138834068,
      "link": null,
      "locked": false,
      "text": "ab kahoge ki ASCII hai then why use Huffman encoding\n\nto dekho ASCII me s 8 bits means 1 byte me represent hota hai \nbut huffman me ye 5 bits me represent hota hai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ab kahoge ki ASCII hai then why use Huffman encoding\n\nto dekho ASCII me s 8 bits means 1 byte me represent hota hai \nbut huffman me ye 5 bits me represent hota hai",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "BBtwxfemFjhP0gqrpSCVT",
      "type": "text",
      "x": 1827.6565979693096,
      "y": 3594.0521598992423,
      "width": 663.0000000306903,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOyf",
      "roundness": null,
      "seed": 276145518,
      "version": 443,
      "versionNonce": 1236611890,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787139023870,
      "link": null,
      "locked": false,
      "text": "Jis chij ko observe karke unhone Static table banaya same whi\nobservation karke unhone huffman table banaya\n\ne.g. \"s\" hum bahut time use karte hai so wo 5 bit se represent\nkarwa diya and backtick(`) hum bahut rarely use karte hai so usko\n15 bits se represent karwa diya so mostly req end up with low\nbandsiwdth that's the simple concept",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jis chij ko observe karke unhone Static table banaya same whi observation karke unhone huffman table banaya\n\ne.g. \"s\" hum bahut time use karte hai so wo 5 bit se represent karwa diya and backtick(`) hum bahut rarely use karte hai so usko 15 bits se represent karwa diya so mostly req end up with low bandsiwdth that's the simple concept",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "SDRGBKbdJN72r3yHhViam",
      "type": "text",
      "x": 1214.747958986782,
      "y": 3152.7915222703177,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
