    {
      "id": "fuY0MHKCkFvBYTNqqXWnS",
      "type": "text",
      "x": 1827.6565982991658,
      "y": 3793.8645846935487,
      "width": 662.9999997008342,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOyh",
      "roundness": null,
      "seed": 1499527534,
      "version": 287,
      "versionNonce": 46922994,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787139023870,
      "link": null,
      "locked": false,
      "text": "huffman me most used characters or most frequent characters or\nfrequently occuring characters or important characters ko less bits\nse represent kiya hai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "huffman me most used characters or most frequent characters or frequently occuring characters or important characters ko less bits se represent kiya hai",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "2hr8cEPVnbCwpJkLen4nW",
      "type": "text",
      "x": 1827.6565979999998,
      "y": 3887.7024717944364,
      "width": 662.9999999999997,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOyi",
      "roundness": null,
      "seed": 476489838,
      "version": 239,
      "versionNonce": 165908146,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787139023870,
      "link": null,
      "locked": false,
      "text": "ASCII is general purpose encoding technique and huffman is\nspecially designed for HPACK\nhuffman us kaam k liye optimised hai jo hum yha kar rhe hai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ASCII is general purpose encoding technique and huffman is specially designed for HPACK\nhuffman us kaam k liye optimised hai jo hum yha kar rhe hai",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "T4Xnx2OolWpItZ2zXB84y",
      "type": "text",
      "x": 1827.6565984827484,
      "y": 3981.5403587705105,
      "width": 662.9999995172518,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cOyj",
      "roundness": null,
      "seed": 1446356402,
      "version": 274,
      "versionNonce": 1746162738,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787139085721,
      "link": null,
      "locked": false,
      "text": "Nhi samjhe table kese bne to search karlena how huffman table\ndesgined why some have too much bits space and mostly alphabets\nhas low number of bits",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nhi samjhe table kese bne to search karlena how huffman table desgined why some have too much bits space and mostly alphabets has low number of bits",
      "autoResize": false,
      "lineHeight": 1.25
    },
