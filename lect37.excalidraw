      "seed": 1175672272,
      "version": 421,
      "versionNonce": 403698990,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787135078106,
      "link": null,
      "locked": false,
      "text": "IMP Note: Frames from different streams (Requests) can be sent in any order (e.g., StreamID 2 Frms then -> StreamID 3 Frms then -> StreamID 1 Frms) However, within a single stream (request), the frame order must be preserved. For example, a DATA frame with StreamID 1 CANNOT be sent before HEADERS frame with StreamID as shown for the green boxes in the diagram with StreamID 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IMP Note: Frames from different streams (Requests) can be sent in any order (e.g., StreamID 2 Frms then -> StreamID 3 Frms then -> StreamID 1 Frms) However, within a single stream (request), the frame order must be preserved. For example, a DATA frame with StreamID 1 CANNOT be sent before HEADERS frame with StreamID as shown for the green boxes in the diagram with StreamID 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
