      "isDeleted": true,
      "boundElements": [],
      "updated": 1787135078106,
      "link": null,
      "locked": false,
      "text": "HTTP1.1 me identifer (means kis req ka konsa res hai) usme order me bhejte the req usi roder me res ata tha so whi identifier tha but here in HTTP2 me order matter nhi karta so ek Stream ID banti hai har ek req ki usi k basis pr identify hota hai so that's identifieer in HTTP2",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP1.1 me identifer (means kis req ka konsa res hai) usme order me bhejte the req usi roder me res ata tha so whi identifier tha but here in HTTP2 me order matter nhi karta so ek Stream ID banti hai har ek req ki usi k basis pr identify hota hai so that's identifieer in HTTP2",
      "autoResize": true,
      "lineHeight": 1.25
