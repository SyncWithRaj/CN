    {
      "id": "RZIoIZrIejApd8MV4QbEY",
      "type": "text",
      "x": 105.74245216468387,
      "y": 813.0734688245582,
      "width": 1113.698974609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
