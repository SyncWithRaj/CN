      "seed": 412962377,
      "version": 219,
      "versionNonce": 482588586,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784650279633,
      "link": null,
      "locked": false,
      "text": "Shown IPs above the devices are assigned by Router to those devices using DHCP and those IPs are virtual IPs",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shown IPs above the devices are assigned by Router to those devices using DHCP and those IPs are virtual IPs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YIpX8o6SaEJ2pRH77BDPB",
      "type": "text",
      "x": 108.25807716468387,
      "y": 860.1242500745582,
      "width": 656.639404296875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cEjq",
      "roundness": null,
      "seed": 1825604327,
      "version": 262,
      "versionNonce": 1278504950,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784650279633,
      "link": null,
      "locked": false,
      "text": "DHC Protocol ka kaam ye hai \nlet's consider our example\nRouter new connected device ko dynamically IP Assign kar deta hai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DHC Protocol ka kaam ye hai \nlet's consider our example\nRouter new connected device ko dynamically IP Assign kar deta hai",
      "autoResize": true,
      "lineHeight": 1.25
    },
