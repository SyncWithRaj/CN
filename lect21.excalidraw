          "type": "arrow"
        }
      ],
      "updated": 1785515854340,
      "link": null,
      "locked": false,
      "text": "ECE (ECN-Echo) Flag: Indicates that network congestion has been detected using Explicit Congestion Notification (ECN).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ECE (ECN-Echo) Flag: Indicates that network congestion has been detected using Explicit Congestion Notification (ECN).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cuKl5nw-snjEHPNmXTyf-",
      "type": "text",
      "x": -2914.735719926199,
      "y": 27120.175917139914,
      "width": 740.8193359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cJGQ",
      "roundness": null,
      "seed": 507615165,
      "version": 60,
      "versionNonce": 192266227,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "kmsMeYf50SUTVqjLxfAuz",
          "type": "arrow"
        },
        {
          "id": "13H92KpSKTRBBlMD3YxrN",
          "type": "arrow"
        }
      ],
      "updated": 1785515861113,
      "link": null,
      "locked": false,
      "text": "The receiver sets the ECE flag to inform the sender about the congestion.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The receiver sets the ECE flag to inform the sender about the congestion.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OaWSKM5feJkEzea6bCXDj",
      "type": "text",
      "x": -2860.361573350139,
      "y": 27173.9845649238,
      "width": 713.4993286132812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cJGR",
      "roundness": null,
      "seed": 558505565,
      "version": 157,
      "versionNonce": 688884189,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "13H92KpSKTRBBlMD3YxrN",
          "type": "arrow"
        }
      ],
      "updated": 1785515871933,
      "link": null,
      "locked": false,
      "text": "The sender then reduces its transmission rate to help avoid packet loss.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The sender then reduces its transmission rate to help avoid packet loss.",
      "autoResize": true,
      "lineHeight": 1.25
    },
