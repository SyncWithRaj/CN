    {
      "id": "0XSdPqd0dZPB3AO1C527r",
      "type": "text",
      "x": -1401.2288387783508,
      "y": 17445.71456006217,
      "width": 1463.140869140625,
      "height": 35.67727062865745,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
