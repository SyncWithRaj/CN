      "updated": 1785505946567,
      "link": null,
      "locked": false,
      "text": "Jab three way handhsake hota hai to firts SYN me sequence number: 0 send hota hai kyunki send\nkarna padta hai seq no. so after connection established the seq number starts with 1",
      "fontSize": 26.915077559235208,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jab three way handhsake hota hai to firts SYN me sequence number: 0 send hota hai kyunki send karna padta hai seq no. so after connection established the seq number starts with 1",
      "autoResize": false,
      "lineHeight": 1.25
    },
