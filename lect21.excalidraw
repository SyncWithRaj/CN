    },
    {
      "id": "rn_WE63s0Z3EBjyO413Xq",
      "type": "text",
      "x": -598.6891160917756,
      "y": 13934.73279769283,
      "width": 246.63975524902344,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cJC1",
      "roundness": null,
      "seed": 725141089,
      "version": 100,
      "versionNonce": 253513053,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785505946567,
      "link": null,
      "locked": false,
      "text": "The Connection is Closed",
      "fontSize": 20,
      "fontFamily": 5,
