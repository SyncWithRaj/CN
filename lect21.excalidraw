    },
    {
      "id": "ByF5NlZLloZe1pIbCOZt0",
      "type": "text",
      "x": -798.1726142115235,
      "y": 8687.210544732185,
      "width": 781.0911865234375,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cJ8Y",
      "roundness": null,
      "seed": 1719658281,
      "version": 239,
      "versionNonce": 1151622003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785505946566,
      "link": null,
      "locked": false,
      "text": "Use cases of TCP:\n- Database connections (Postgres/Mysql/MongoDB/etc.)\n- HTTP(S)/REST APIs\n- File Transfer Protocol (FTP)\n- Email (SMTP, IMAP, POP3)\n- SSH",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use cases of TCP:\n- Database connections (Postgres/Mysql/MongoDB/etc.)\n- HTTP(S)/REST APIs\n- File Transfer Protocol (FTP)\n- Email (SMTP, IMAP, POP3)\n- SSH",
      "autoResize": true,
      "lineHeight": 1.25
    },
