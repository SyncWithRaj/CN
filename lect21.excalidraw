      "isDeleted": false,
      "boundElements": null,
      "updated": 1785522321781,
      "link": null,
      "locked": false,
      "text": "- Source Port: 2bytes\n- Destination Port: 2 bytes\n- Sequence Number: 4 bytes -> 32 bits -> 2^32 -> ~4Billiom\n- Acknowledgement number: 4 bytes -> 32 bits -> 2^32 -> ~4Billion\n- Data Offset: 4 bits\n- reserved : 4 bits\n- flags: 8 bites = 1  byte\n- window size: 2 bytes\n- checksum: 2  bytes\n- Urgent Pointer: 2 bytes\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Source Port: 2bytes\n- Destination Port: 2 bytes\n- Sequence Number: 4 bytes -> 32 bits -> 2^32 -> ~4Billiom\n- Acknowledgement number: 4 bytes -> 32 bits -> 2^32 -> ~4Billion\n- Data Offset: 4 bits\n- reserved : 4 bits\n- flags: 8 bites = 1  byte\n- window size: 2 bytes\n- checksum: 2  bytes\n- Urgent Pointer: 2 bytes\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
