      "isDeleted": false,
      "boundElements": null,
      "updated": 1784889840145,
      "link": null,
      "locked": false,
      "text": "Some Use cases of UDP:\n- WebRTC (Web Real-Time Communication)\n- Gameplay traffic\n- Video Streaming\n- VPN - OpenVPN\n- DNS\n- QUIC",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Some Use cases of UDP:\n- WebRTC (Web Real-Time Communication)\n- Gameplay traffic\n- Video Streaming\n- VPN - OpenVPN\n- DNS\n- QUIC",
      "autoResize": true,
      "lineHeight": 1.25
    },
