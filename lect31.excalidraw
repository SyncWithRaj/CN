      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cNga",
      "roundness": null,
      "seed": 369981970,
      "version": 160,
      "versionNonce": 1716798461,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786428944254,
      "link": null,
      "locked": false,
      "text": "Limitation is that jab tak ek\nreq ka respose nhi ata tab\ntk hum dusri req nhi bhej\nskte",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
