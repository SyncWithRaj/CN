    {
      "id": "vwYFpn526SrDxj1jRBxVZ",
      "type": "text",
      "x": 1237.333557519023,
      "y": 4407.351635009636,
      "width": 1002.1169258951833,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
