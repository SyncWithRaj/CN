      "isDeleted": true,
      "boundElements": [],
      "updated": 1785692411731,
      "link": null,
      "locked": false,
      "text": "hum communicate kar rhe hai  on network using TCP kuch gadbad ho gai hai(e.g. mera server crash kar gaya (port hi band ho gaya)) immediately mujhe RST segment aayega in TCP as RST=1 ki connecion close karo aur ye GRACEFUL nhi hoga connection close",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hum communicate kar rhe hai  on network using TCP kuch gadbad ho gai hai(e.g. mera server crash kar gaya (port hi band ho gaya)) immediately mujhe RST segment aayega in TCP as RST=1 ki connecion close karo aur ye GRACEFUL nhi hoga connection close",
      "autoResize": true,
      "lineHeight": 1.25
    },
