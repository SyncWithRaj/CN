    {
      "id": "xzGd2g_DeoijrMCotbSvP",
      "type": "text",
      "x": -1380.5997520525657,
      "y": 13207.721255139875,
      "width": 462.1538362927556,
      "height": 60.98953682729552,
      "angle": 0,
