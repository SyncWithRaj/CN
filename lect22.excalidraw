    {
      "id": "Ga_6_l0k8vdjrW_mD9mr8",
      "type": "text",
      "x": -2984.766515223059,
      "y": 27066.60430182728,
      "width": 1198.23876953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
