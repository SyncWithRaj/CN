    {
      "id": "SaXxx0hObfjVbIQRn9wtJ",
      "type": "text",
      "x": 86.77603465770181,
      "y": 3234.47818962405,
      "width": 446.3196105957031,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
