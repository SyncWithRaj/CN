      "seed": 1309441452,
      "version": 185,
      "versionNonce": 1275145374,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "router ECN k 2 bit ko 11 kar\ndega that means Congestion\nExperienced jab bhi router ki\nhalat kharab ho",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "router ECN k 2 bit ko 11 kar dega that means Congestion Experienced jab bhi router ki halat kharab ho",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "exZuiqj47E6UDYCO3sdFW",
      "type": "text",
      "x": 5609.634107032828,
      "y": 11428.736737618754,
      "width": 820.8044154671715,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b6965e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLSx",
      "roundness": null,
      "seed": 1762228372,
      "version": 339,
      "versionNonce": 1366029378,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "Abhi tak sirf receiver and rotuer  ko m alum hai ki congestion expience ho rha hai but sender ko bhi to\npta hona chahiye kyunki who packet send kar rha hai to ab receiver sender ko kese batayega? let's see",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Abhi tak sirf receiver and rotuer  ko m alum hai ki congestion expience ho rha hai but sender ko bhi to pta hona chahiye kyunki who packet send kar rha hai to ab receiver sender ko kese batayega? let's see",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "QF-SGIgmvC8687zOXMSiv",
      "type": "text",
      "x": 5609.6341073473695,
      "y": 11491.707877564251,
      "width": 705.683210547244,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b6965e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLSy",
      "roundness": null,
      "seed": 1031984276,
      "version": 291,
      "versionNonce": 1118693598,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "isse pehle jo humne traditional chije dekhi usme sab kuch sender kar rhah tha that means\ninfo(ECN set to 11 means CE) ka asli haqdaar sender hai",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "isse pehle jo humne traditional chije dekhi usme sab kuch sender kar rhah tha that means info(ECN set to 11 means CE) ka asli haqdaar sender hai",
      "autoResize": false,
