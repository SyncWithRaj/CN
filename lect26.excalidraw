      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872409,
      "link": null,
      "locked": false,
      "text": "This is how TCP kind of uses congestion window ka concept and Receiver window ka\nconccept to do congestion ccontrol and flow control at same time :)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is how TCP kind of uses congestion window ka concept and Receiver window ka conccept to do congestion ccontrol and flow control at same time :)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "WJSC0i5wUR6nHJ6khEX32",
      "type": "text",
      "x": 1754.227319468421,
      "y": 10580.576801809706,
      "width": 8,
      "height": 25,
      "angle": 0,
