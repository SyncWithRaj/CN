      "seed": 1627210156,
      "version": 135,
      "versionNonce": 1588495234,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "TCP ko pta chala ECE=1 se ECN se ki fuuture ma maybe congestionn ho skta hai then what it will do? ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TCP ko pta chala ECE=1 se ECN se ki fuuture ma maybe congestionn ho skta hai then what it will do? ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jQm_zMm-8B6eaUaKticsA",
      "type": "text",
      "x": 5611.43852213713,
      "y": 11855.58434314612,
      "width": 868.2738037109375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLT4",
      "roundness": null,
      "seed": 958993836,
      "version": 138,
      "versionNonce": 492538334,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "then it will act like Triple Duplicate ACKs (ye koi itna serious problem nhi hai (Congestion abhi tak hua nhi hai))",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "then it will act like Triple Duplicate ACKs (ye koi itna serious problem nhi hai (Congestion abhi tak hua nhi hai))",
      "autoResize": true,
      "lineHeight": 1.25
    },
