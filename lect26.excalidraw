    {
      "id": "mtlRTJEslP20tI1CbrCYl",
      "type": "text",
      "x": 80.38722493138232,
      "y": 2742.9870233988245,
      "width": 670.2992212867099,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
