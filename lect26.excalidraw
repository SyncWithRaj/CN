      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "NOTE: Although the latest TCP specification defines the AE\n(Accurate ECN) flag, Accurate ECN is not yet widelt deployed.\nthereore, you'lltypically see the AE flag present but unset(0)\nin most TCP connections captured with Wireshark",
      "fontSize": 12.132205134025572,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: Although the latest TCP specification defines the AE (Accurate ECN) flag, Accurate ECN is not yet widelt deployed. thereore, you'lltypically see the AE flag present but unset(0) in most TCP connections captured with Wireshark",
      "autoResize": false,
      "lineHeight": 1.25
    },
