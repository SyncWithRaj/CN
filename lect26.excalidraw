    {
      "id": "CrUV0NY91l_hrAlbg7Nvn",
      "type": "text",
      "x": 5611.438522956893,
      "y": 12739.474552345097,
      "width": 883.9999995431062,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
