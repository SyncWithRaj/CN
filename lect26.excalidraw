    {
      "id": "SaXxx0hObfjVbIQRn9wtJ",
      "type": "text",
      "x": 93.53384715770181,
      "y": 3241.23600212405,
      "width": 446.3196105957031,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLPg",
      "roundness": null,
      "seed": 443616142,
      "version": 344,
      "versionNonce": 2018966558,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872407,
      "link": null,
      "locked": false,
      "text": "PMTUD (Path MTU Discovery)\n- Mechanism to discover PMTU (Path's MTU)\n- Prevents fragmentation\n- Sender starts with larger packets\n- Uss DF (Don't Fragment) bit\n- Routers drop oversized packets\n- Router sends ICMP \"Fragmentation Needed\"\n- Sender reduces packet size\n- Continues until packet pass successfully",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PMTUD (Path MTU Discovery)\n- Mechanism to discover PMTU (Path's MTU)\n- Prevents fragmentation\n- Sender starts with larger packets\n- Uss DF (Don't Fragment) bit\n- Routers drop oversized packets\n- Router sends ICMP \"Fragmentation Needed\"\n- Sender reduces packet size\n- Continues until packet pass successfully",
      "autoResize": true,
      "lineHeight": 1.25
    },
