      "link": null,
      "locked": false,
      "text": "NOTE: In Modern TCP, One of these reserve bits is\ndefined the NS(Nonce Sum) flag but it is rarely used\nand is omitted here for simplycity. Just an FYI :)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: In Modern TCP, One of these reserve bits is defined the NS(Nonce Sum) flag but it is rarely used and is omitted here for simplycity. Just an FYI :)",
      "autoResize": false,
      "lineHeight": 1.25
    },
