    {
      "id": "zb5Izh976DjciXH-Vguzf",
      "type": "text",
      "x": 5609.634107229783,
      "y": 10410.86523484305,
      "width": 535.8890380859375,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b6965e",
      "fillStyle": "solid",
