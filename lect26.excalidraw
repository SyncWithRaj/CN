    {
      "id": "SYISjGNl79db1-A3yUYg5",
      "type": "text",
      "x": 972.4344569994383,
      "y": 11726.117688815304,
      "width": 713.1285921254505,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
