    {
      "id": "kapp0ErMdaCYqjdj7BFwU",
      "type": "text",
      "x": 3083.1918360602344,
      "y": 12141.481434008749,
      "width": 1048.448978421252,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLSD",
      "roundness": null,
      "seed": 1897898260,
      "version": 633,
      "versionNonce": 1166111170,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872409,
      "link": null,
      "locked": false,
      "text": "Valid Question: \"If CWND is measured in bytes, what happens to fractional values like 128.015? Can TCP send fractional bytes?\n\nAnswer: No. TCP Can only send whole bytes/segments. Fractional cwnd values are conceptual representation of the gradual growth.\nReal implementation accumulate these fractions internally, and the sender gains additional sending capacity only when anough growth\nhas accumulated",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Valid Question: \"If CWND is measured in bytes, what happens to fractional values like 128.015? Can TCP send fractional bytes?\n\nAnswer: No. TCP Can only send whole bytes/segments. Fractional cwnd values are conceptual representation of the gradual growth. Real implementation accumulate these fractions internally, and the sender gains additional sending capacity only when anough growth has accumulated",
      "autoResize": false,
      "lineHeight": 1.25
    },
