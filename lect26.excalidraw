      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "CWR (Congestion Window Reduced) Flag: Indicates that the sender has received the ECE signal and reduced its congestion window.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CWR (Congestion Window Reduced) Flag: Indicates that the sender has received the ECE signal and reduced its congestion window.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Nna9Gg7taWoFoH6iZbUud",
      "type": "text",
      "x": -2923.357180796345,
      "y": 27310.662747671595,
      "width": 640.9392700195312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNb",
      "roundness": null,
      "seed": 1200768605,
      "version": 52,
      "versionNonce": 2050491230,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "It acknowledges the congestion notification sent by the receiver.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It acknowledges the congestion notification sent by the receiver.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YjCN2lZVFttIldabaeSHt",
      "type": "text",
      "x": -2878.2466712831806,
      "y": 27364.0920409147,
      "width": 631.2794189453125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNc",
      "roundness": null,
      "seed": 1066369277,
      "version": 81,
      "versionNonce": 1740827010,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "This helps control network congestion and prevents packet loss.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This helps control network congestion and prevents packet loss.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6Z7Z-whSheHSJRYlXVy31",
      "type": "arrow",
      "x": -2976.0635847009075,
