      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNq",
      "roundness": null,
      "seed": 1370316019,
      "version": 220,
      "versionNonce": 1555238850,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "Possible  Header Options of TCP Segment:\n- MSS (Maximum Segment Size)\n- Timestamp\n- Window scale\n- Selective Ack is supported etc...\n\nTCP Options can grow up to 40 bytes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Possible  Header Options of TCP Segment:\n- MSS (Maximum Segment Size)\n- Timestamp\n- Window scale\n- Selective Ack is supported etc...\n\nTCP Options can grow up to 40 bytes",
      "autoResize": true,
      "lineHeight": 1.25
    },
