    {
      "id": "qbt-4aYMvVhUCIuICaE2D",
      "type": "text",
      "x": -917.9040174040117,
      "y": 11681.1572752542,
      "width": 967.2391357421875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLIw",
      "roundness": null,
      "seed": 402708728,
      "version": 167,
      "versionNonce": 1174230466,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "Kuch states hai jo wo manage kar rhe hai on the host machine that's why this is stateful protocol",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kuch states hai jo wo manage kar rhe hai on the host machine that's why this is stateful protocol",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yM7juGeRbtC-G_n5z3kmk",
      "type": "text",
      "x": -909.9791526921929,
      "y": 11740.004475780936,
      "width": 957.4628123370251,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLIx",
      "roundness": null,
      "seed": 1697297032,
      "version": 122,
      "versionNonce": 595418974,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "TCP is stateful because it maintains the state of each connection (using a 3-way handshake),\ntracks sequence numbers, acknowledgments, and connection status throughout the communication.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TCP is stateful because it maintains the state of each connection (using a 3-way handshake), tracks sequence numbers, acknowledgments, and connection status throughout the communication.",
      "autoResize": false,
      "lineHeight": 1.25
    },
