    {
      "id": "GKMKfNf-bFt-yP6SvNWMb",
      "type": "text",
      "x": 1950.6702853674435,
      "y": 11445.030863648828,
      "width": 517.8699541006322,
      "height": 120,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLS9",
      "roundness": null,
      "seed": 1978789036,
      "version": 652,
      "versionNonce": 79444610,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872409,
      "link": null,
      "locked": false,
      "text": "IMP NOTE: For simplicity, we've used a simplified version of the\nTCP congestion control formulas by assuming 1 MSS = 1  bbyte.\nReal TCP implementations follow the RFCs (RFC 5681), which\ninclude additional refinements for scenarios such as cumulative\nACKs and delayed ACKs. These are just implementation details,\nthe core concepts explained here remain the same",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IMP NOTE: For simplicity, we've used a simplified version of the TCP congestion control formulas by assuming 1 MSS = 1  bbyte. Real TCP implementations follow the RFCs (RFC 5681), which include additional refinements for scenarios such as cumulative ACKs and delayed ACKs. These are just implementation details, the core concepts explained here remain the same",
      "autoResize": false,
      "lineHeight": 1.25
    },
