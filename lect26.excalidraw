    {
      "id": "kG_V3tICvEvFfafk8JW11",
      "type": "text",
      "x": 1945.4333875227685,
      "y": 12536.537725806435,
      "width": 1093.0264892578125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
