    {
      "id": "CnW3Oc74KpcneDEFdeZ5Q",
      "type": "text",
      "x": -410.9910902548323,
      "y": 15347.608442839348,
      "width": 496.113669693646,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLKh",
      "roundness": null,
      "seed": 1217694657,
      "version": 468,
      "versionNonce": 1819561182,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "NOTE: I've split the data into simple chunks just\nfor demonstration. In practice, the size of each\nTCP segment is primarily determined by the MSS\n(Maximum Segment Size) and other TCP factors.\nWe'll cover MSS in a dedicated video. Here, the\ngoal is only to understand sequence numbers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: I've split the data into simple chunks just for demonstration. In practice, the size of each TCP segment is primarily determined by the MSS (Maximum Segment Size) and other TCP factors. We'll cover MSS in a dedicated video. Here, the goal is only to understand sequence numbers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
