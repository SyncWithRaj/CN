      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: For simplicity, this example assumes Stop-and-wait behaviour. In reality, TCP does not use the Stop-and-Wait protocol, it uses a Sliding window, which we'll cover next in this video",
      "autoResize": false,
      "lineHeight": 1.25
    },
