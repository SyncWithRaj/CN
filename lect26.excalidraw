    {
      "id": "zVNjKOCd5oz4zhg6wt2Xo",
      "type": "text",
      "x": -2828.708018076484,
      "y": 27838.60379369233,
      "width": 416.859619140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
