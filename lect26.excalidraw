    {
      "id": "LAtBWd7dc6IrHI7fMy1W2",
      "type": "text",
      "x": 4190.045963391176,
      "y": 6631.233112895417,
      "width": 855.2344990015029,
      "height": 44.78515625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLQN",
      "roundness": null,
      "seed": 1598964905,
      "version": 252,
      "versionNonce": 1112772226,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872407,
      "link": null,
      "locked": false,
      "text": "Receiver ne ACK to bhej iya but uske pass buffer  khali nhi hai kyunki express ne consume nhi kiya\nso wo ACK k saath widow size bhi bhejega batane k liye kitna space khali hai",
      "fontSize": 17.914062499999996,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Receiver ne ACK to bhej iya but uske pass buffer  khali nhi hai kyunki express ne consume nhi kiya\nso wo ACK k saath widow size bhi bhejega batane k liye kitna space khali hai",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6qVqTNx3UVe5kxWUh2LDX",
      "type": "text",
      "x": 4190.487369328676,
      "y": 6687.199910770418,
      "width": 854.25927734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLQO",
      "roundness": null,
      "seed": 1535514439,
      "version": 195,
      "versionNonce": 1767117470,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872407,
      "link": null,
      "locked": false,
      "text": "Soabhi mera sender segment 4 bhi bhejega this is FLOW CONTROL you are awareabout \nki receiver ka bhi kitna window empty hai :)to accept the segment",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Soabhi mera sender segment 4 bhi bhejega this is FLOW CONTROL you are awareabout \nki receiver ka bhi kitna window empty hai :)to accept the segment",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xODvR3jVtkqdnc237XIGc",
      "type": "text",
      "x": 4190.045963516175,
      "y": 6748.381551395418,
      "width": 792.5394287109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLQP",
      "roundness": null,
      "seed": 1209527975,
      "version": 168,
      "versionNonce": 329412162,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872407,
      "link": null,
      "locked": false,
      "text": "Okay ab sender ko bhi maalum pad gaya ki abhi ye segment nhi bhejna hai but but\nAb sender ko kese pta chalega ki is segment ko kab bhejna hai??????????",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Okay ab sender ko bhi maalum pad gaya ki abhi ye segment nhi bhejna hai but but\nAb sender ko kese pta chalega ki is segment ko kab bhejna hai??????????",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0a1EhsfjNwxvvrZ4skyya",
      "type": "text",
      "x": 4190.045963516176,
      "y": 6809.563192395417,
      "width": 832.8592529296875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLQQ",
      "roundness": null,
      "seed": 672049545,
      "version": 178,
      "versionNonce": 1085542110,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872407,
      "link": null,
      "locked": false,
      "text": "Now when let say expressed consumes the data in buffer then receiver send another \nACK req with window size: 3bytes CALLLED as WINDOW UPDATED EVENT",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now when let say expressed consumes the data in buffer then receiver send another \nACK req with window size: 3bytes CALLLED as WINDOW UPDATED EVENT",
      "autoResize": true,
      "lineHeight": 1.25
    },
