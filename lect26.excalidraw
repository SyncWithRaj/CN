    {
      "id": "MvD-IhkLIbLC7kUYZtyOf",
      "type": "text",
      "x": 80.3872249455093,
      "y": 2430.713306495689,
      "width": 650.8994140625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLPC",
      "roundness": null,
      "seed": 2081618386,
      "version": 403,
      "versionNonce": 1719372098,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872407,
      "link": null,
      "locked": false,
      "text": "MSS (Maximum Segment Size)\n- TCP-only  concept\n- Maximum TCP Payload in a single segment (Except TCP Headers)\n- MSS = MTU - IP Header - TCP Header\n- Standard Ethernet MSS = 1460 bytes = 1500 - 20 - 20\n- Advertisedduring TCP three-way handshake\n- Carried in TCP MSS option\n- MSS helps avoid fragmentation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MSS (Maximum Segment Size)\n- TCP-only  concept\n- Maximum TCP Payload in a single segment (Except TCP Headers)\n- MSS = MTU - IP Header - TCP Header\n- Standard Ethernet MSS = 1460 bytes = 1500 - 20 - 20\n- Advertisedduring TCP three-way handshake\n- Carried in TCP MSS option\n- MSS helps avoid fragmentation",
      "autoResize": true,
      "lineHeight": 1.25
    },
