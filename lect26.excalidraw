    {
      "id": "p2u-pVePMeok9rRUBTtBF",
      "type": "text",
      "x": 1366.6257749085378,
      "y": 9019.998460660814,
      "width": 1007.248046875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#96f2d7",
