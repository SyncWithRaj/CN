    {
      "id": "yhpLEMgdZ2bpbz45EvI1-",
      "type": "text",
      "x": 4434.224194100047,
      "y": 11142.127757035558,
      "width": 970.6601081713825,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLSX",
      "roundness": null,
      "seed": 1244067348,
      "version": 344,
      "versionNonce": 1894050206,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872409,
      "link": null,
      "locked": false,
      "text": "RTO:\nsender ne segments bheje and then wo timer start karta hai maanlo timer expire ho gaya but usko abhi tak ACK nhi mila\nthen wo maan leta hai ki packet drop hua hai and TCP considered this as a strong indication of congestion",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RTO:\nsender ne segments bheje and then wo timer start karta hai maanlo timer expire ho gaya but usko abhi tak ACK nhi mila then wo maan leta hai ki packet drop hua hai and TCP considered this as a strong indication of congestion",
      "autoResize": false,
      "lineHeight": 1.25
    },
