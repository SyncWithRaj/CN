      "seed": 1279983892,
      "version": 289,
      "versionNonce": 2008066782,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872410,
      "link": null,
      "locked": false,
      "text": "This CWR = 1 flag (in TCP header) is to inform the receiver, that sender has reacted to receiver's ECE=1 by\nreducing the CWND, allowing the receiver to stop setting the ECCE=1 flag further again and again",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This CWR = 1 flag (in TCP header) is to inform the receiver, that sender has reacted to receiver's ECE=1 by reducing the CWND, allowing the receiver to stop setting the ECCE=1 flag further again and again",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "W-6qmcJvGcRJVx3YxGooM",
      "type": "text",
      "x": 5610.23167344363,
      "y": 12788.02781158996,
      "width": 767.7776818469877,
