    },
    {
      "id": "TQW6NOXnuWQhnQp863PIU",
      "type": "text",
      "x": -2166.51372480659,
      "y": 28285.544326376108,
      "width": 543.53955078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNt",
      "roundness": null,
      "seed": 2042340979,
      "version": 136,
      "versionNonce": 358869406,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "Possible at max TCP Segment can hve header size  of: \n20 bytes + 40 bytes(Optionall headers) = 60 bytes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Possible at max TCP Segment can hve header size  of: \n20 bytes + 40 bytes(Optionall headers) = 60 bytes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-t3MaqoU1tcoedlcqPL8E",
      "type": "text",
      "x": 139.7578125,
      "y": 210.2578125,
      "width": 577.0594482421875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNu",
      "roundness": null,
      "seed": 1988551186,
      "version": 370,
      "versionNonce": 1855927390,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872405,
      "link": null,
      "locked": false,
      "text": "MTU (Maximum Transmission Unit)\n- Largest IP packet a link can carry without fragmentation\n- MTU includes IP header + TCP/UDP header + payload\n- Ethernet header is not part of MTU (IMPORTANT)\n- Ethernet MTU is typically 1500 bytes\n- Different links can have different MTUs\n- Exceeding MTU can cause fragmentation or packet drops",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MTU (Maximum Transmission Unit)\n- Largest IP packet a link can carry without fragmentation\n- MTU includes IP header + TCP/UDP header + payload\n- Ethernet header is not part of MTU (IMPORTANT)\n- Ethernet MTU is typically 1500 bytes\n- Different links can have different MTUs\n- Exceeding MTU can cause fragmentation or packet drops",
      "autoResize": true,
      "lineHeight": 1.25
    },
