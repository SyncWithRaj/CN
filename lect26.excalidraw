      "updated": 1786033872408,
      "link": null,
      "locked": false,
      "text": "This is nothing but your sliding window of TCP. And it is a\npart of the flow control. And it uses window size to kind of\noptimistically send or control the flow of packets over the\nnetwork in TCP",
      "fontSize": 26.692382812500007,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is nothing but your sliding window of TCP. And it is a part of the flow control. And it uses window size to kind of optimistically send or control the flow of packets over the network in TCP",
      "autoResize": false,
      "lineHeight": 1.25
    },
