      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872409,
      "link": null,
      "locked": false,
      "text": "as you can see above after 128 ACK window size 128 -> 129 and if we used the slow sart then it will be 128 + 128 = 256. see difference :)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "as you can see above after 128 ACK window size 128 -> 129 and if we used the slow sart then it will be 128 + 128 = 256. see difference :)",
      "autoResize": true,
      "lineHeight": 1.25
