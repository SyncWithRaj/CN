      "locked": false,
      "text": "Normally when ECN is set then it means\nthat congestion is happening but\nexceptionally when our first req sent\nand EXN set to 1 (set) the it doen't\nmean that congestion is happening",
      "fontSize": 13.225478745720476,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Normally when ECN is set then it means that congestion is happening but exceptionally when our first req sent and EXN set to 1 (set) the it doen't mean that congestion is happening",
      "autoResize": false,
      "lineHeight": 1.25
    },
