      "seed": 371708716,
      "version": 184,
      "versionNonce": 163889118,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033872409,
      "link": null,
      "locked": false,
      "text": "RWND to muje khud receiver bata dega 3-way handhshake me and ACK ke saath wo updates window size bhi bata dega",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
