    {
      "id": "sQeMFklYnRQSFhXW7EmMC",
      "type": "text",
      "x": 6200.021521230268,
      "y": 11043.18772289735,
      "width": 230.41700126973132,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b6965e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
