    {
      "id": "bklPBv8I7Y57tVRDsjsKL",
      "type": "text",
      "x": -2980.7314886773897,
      "y": 27256.65723427609,
      "width": 1289.938720703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
