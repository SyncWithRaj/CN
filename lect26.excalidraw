      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Matlab mene 128 segments bheje aur when i got 128 acknowledgement theen i will increase congestion window by 1 that's why we used CWND + 1/CWND.",
      "autoResize": true,
