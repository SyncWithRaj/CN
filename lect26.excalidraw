    {
      "id": "Ga_6_l0k8vdjrW_mD9mr8",
      "type": "text",
      "x": -2984.766515223059,
      "y": 27066.60430182728,
      "width": 1198.23876953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNV",
      "roundness": null,
      "seed": 250521235,
      "version": 85,
      "versionNonce": 723199646,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "ECE (ECN-Echo) Flag: Indicates that network congestion has been detected using Explicit Congestion Notification (ECN).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ECE (ECN-Echo) Flag: Indicates that network congestion has been detected using Explicit Congestion Notification (ECN).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cuKl5nw-snjEHPNmXTyf-",
      "type": "text",
      "x": -2914.735719926199,
      "y": 27120.175917139914,
      "width": 740.8193359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNW",
      "roundness": null,
      "seed": 507615165,
      "version": 66,
      "versionNonce": 75930178,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "The receiver sets the ECE flag to inform the sender about the congestion.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The receiver sets the ECE flag to inform the sender about the congestion.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OaWSKM5feJkEzea6bCXDj",
      "type": "text",
      "x": -2860.361573350139,
      "y": 27173.9845649238,
      "width": 713.4993286132812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cLNX",
      "roundness": null,
      "seed": 558505565,
      "version": 163,
      "versionNonce": 1618518750,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786033857335,
      "link": null,
      "locked": false,
      "text": "The sender then reduces its transmission rate to help avoid packet loss.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The sender then reduces its transmission rate to help avoid packet loss.",
      "autoResize": true,
      "lineHeight": 1.25
    },
