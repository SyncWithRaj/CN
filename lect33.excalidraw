      "isDeleted": true,
      "boundElements": [],
      "updated": 1786554714131,
      "link": null,
      "locked": false,
      "text": "A recursive DNS resolvers\ncache is generally shared\nacross all clients that\nuse that resolver",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A recursive DNS resolvers cache is generally shared across all clients that use that resolver",
      "autoResize": false,
      "lineHeight": 1.25
    },
