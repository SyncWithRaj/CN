      "boundElements": [],
      "updated": 1786734489409,
      "link": null,
      "locked": false,
      "text": "you can see all above data in developer tool > application\n\nHost is actual domain name regardless ki konse route pr aap ho (e.g. api.freeapi.app)\nand \nreferer means actual route or that complete page (e.g. api/freeapi/app/test/274024)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
