      "isDeleted": true,
      "boundElements": [],
      "updated": 1786554714131,
      "link": null,
      "locked": false,
      "text": "Limitation is that jab tak ek\nreq ka respose nhi ata tab\ntk hum dusri req nhi bhej\nskte",
