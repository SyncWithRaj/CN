      "isDeleted": true,
      "boundElements": [],
      "updated": 1786554714131,
      "link": null,
      "locked": false,
      "text": "http1.0 me keep-alive header\njo hume bhejna padt tha wo\nhttp1.1 me default behaviour\nhota hai\n\ncreates single connection for\nmultiple requests.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "http1.0 me keep-alive header jo hume bhejna padt tha wo http1.1 me default behaviour hota hai\n\ncreates single connection for multiple requests.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
