      "isDeleted": false,
      "boundElements": null,
      "updated": 1786427952160,
      "link": null,
      "locked": false,
      "text": "Limitation is that jab tak ek\nreq ka respose nhi ata tab\ntk hum dusri req nhi bhej\nskte",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
