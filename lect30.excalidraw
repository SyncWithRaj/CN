      "link": null,
      "locked": false,
      "text": "Keep-Alive is an optional header in HTTP 1.0",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Keep-Alive is an optional header in HTTP 1.0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XQLnLEUL-puEGTRHB8oE0",
      "type": "text",
      "x": -153.3307969835078,
      "y": 2554.420181522455,
      "width": 1019.359130859375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
