      "boundElements": [],
      "updated": 1785172082520,
      "link": null,
      "locked": false,
      "text": "mtlb dns me ek ID bhi send hoti hai agar timeout ho gaya ya kisi bhi reason se\npaacketloss ho gaya then DNS automatically send req again to diff or same\nDNS sevrer so if loss haappened then req again automatically by DNS",
      "fontSize": 20,
