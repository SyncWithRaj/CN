    {
      "id": "OdqCJjrftNCIx6dt1AaFI",
      "type": "text",
      "x": 1030.1718119950513,
      "y": 604.1236928585804,
      "width": 1521.9190673828125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cEF4",
      "roundness": null,
      "seed": 1055966921,
      "version": 301,
      "versionNonce": 1856622068,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784548573372,
      "link": null,
      "locked": false,
      "text": "Laptop ko ye nhi pata ki mobile network me hai ya nhi but \nlapotp router ko bolta hai mujhe nhi pata lekin mujh eye pata hai ki tujhe pata hai mobile netowrk me hai ki nhi to tu ye le data and mbile ko send kar dena \nrouter kuch bhi karke usko send kar dega\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Laptop ko ye nhi pata ki mobile network me hai ya nhi but \nlapotp router ko bolta hai mujhe nhi pata lekin mujh eye pata hai ki tujhe pata hai mobile netowrk me hai ki nhi to tu ye le data and mbile ko send kar dena \nrouter kuch bhi karke usko send kar dega\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GkHwS_aB8qJiGDO07Hnco",
      "type": "text",
      "x": 1027.1736244703975,
      "y": 722.0635374913337,
      "width": 1067.19921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cEF5",
      "roundness": null,
      "seed": 172475559,
      "version": 226,
      "versionNonce": 68762444,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784548573372,
      "link": null,
      "locked": false,
      "text": "Laptop assuming that router ko pata hoga mobile kaha hai to tu data usko bhej de me router ko bhej rha hu",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Laptop assuming that router ko pata hoga mobile kaha hai to tu data usko bhej de me router ko bhej rha hu",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ERRap2nO1GT69wYbx2lyc",
      "type": "text",
      "x": 1025.185968117006,
      "y": 784.8542698147548,
      "width": 1400.678955078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cEF6",
      "roundness": null,
      "seed": 1248178217,
      "version": 250,
      "versionNonce": 1369698164,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784548573372,
      "link": null,
      "locked": false,
      "text": "Laptop ko kese pata router default gateway hai??\nasal me ye pre configured hota hai jab bhi laptop router se connect hota hai to usko by default pata hota hai ki uska default gateway kya hai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Laptop ko kese pata router default gateway hai??\nasal me ye pre configured hota hai jab bhi laptop router se connect hota hai to usko by default pata hota hai ki uska default gateway kya hai",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7PjxpWn81FQ3z-9YgHpkZ",
      "type": "text",
      "x": 1023.8163225625683,
      "y": 870.5907409236521,
      "width": 937.09912109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cEF7",
      "roundness": null,
      "seed": 738023913,
      "version": 144,
      "versionNonce": 2121003468,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784548573372,
      "link": null,
      "locked": false,
      "text": "a device which knows how to conenct outside the network is your default gateway (e.g. router)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a device which knows how to conenct outside the network is your default gateway (e.g. router)",
      "autoResize": true,
      "lineHeight": 1.25
    },
