      "isDeleted": false,
      "boundElements": [],
      "updated": 1786989434035,
      "link": null,
      "locked": false,
      "text": "Note: HTTP/2 can have another HEADERS frame later in the same stream for trailing headers (Trailers) this is not common in regular web traffic but is used by protocols like gRPC",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: HTTP/2 can have another HEADERS frame later in the same stream for trailing headers (Trailers) this is not common in regular web traffic but is used by protocols like gRPC",
      "autoResize": true,
      "lineHeight": 1.25
    },
