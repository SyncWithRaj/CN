      "isDeleted": false,
      "boundElements": null,
      "updated": 1786989824494,
      "link": null,
      "locked": false,
      "text": "HTTP1.1 is text based protocol as we see below",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP1.1 is text based protocol as we see below",
