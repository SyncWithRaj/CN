      "text": "ab kahoge ye to HTTP1.1 me tha??\nbut here i catch\nsee in order of responses we getting image.png first means whichever req get fullfilled first get served first",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ab kahoge ye to HTTP1.1 me tha??\nbut here i catch\nsee in order of responses we getting image.png first means whichever req get fullfilled first get served first",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Z9ITkA8VmBQjjRgJm1L60",
      "type": "text",
      "x": -818.3118606944356,
      "y": 7144.455605425566,
      "width": 2741.777587890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
