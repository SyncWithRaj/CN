    {
      "id": "vTcJP0cYXPtAMyIVouaef",
      "type": "text",
      "x": -845.5389598325371,
      "y": 11266.721577032618,
      "width": 1772.4984130859375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
