    },
    {
      "id": "78mDO4JGgOxTQIbGynAc2",
      "type": "text",
      "x": -1103.327209053365,
      "y": 13897.625347870206,
      "width": 1288.178955078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
