      "text": "Ye ekdam raw req hai isi format me req server ko bhi milta haii",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ye ekdam raw req hai isi format me req server ko bhi milta haii",
      "autoResize": true,
