    {
      "id": "gw3OBCfRhx8vkBtIhtYkd",
      "type": "text",
      "x": -798.1726140158065,
      "y": 7853.126756920478,
      "width": 1586.9908447265625,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
