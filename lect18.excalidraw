    {
      "id": "nnW6aH1B_Y2E-usY-sgys",
      "type": "text",
      "x": -649.0350676127391,
      "y": 9934.41191317048,
      "width": 762.740234375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cHso",
      "roundness": null,
      "seed": 1101229960,
      "version": 362,
      "versionNonce": 897471112,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785228964530,
      "link": null,
      "locked": false,
      "text": "Why do we need a connection? - TCP is a stateful protocol, so both devices\nmust establish and synchronize connection state before exchanging data\nreliably. This is a fundamental requirement for reliable communication.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why do we need a connection? - TCP is a stateful protocol, so both devices must establish and synchronize connection state before exchanging data reliably. This is a fundamental requirement for reliable communication.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "urOqkxKuxNSqWPIJX9ENi",
      "type": "text",
      "x": 5.50638147184759,
      "y": 10170.332098340268,
      "width": 823.6708984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#099268",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cHsp",
      "roundness": null,
      "seed": 613531016,
      "version": 405,
      "versionNonce": 1377028232,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785229920304,
      "link": null,
      "locked": false,
      "text": "NOTE: TCP doea allow a SYN segment to include data, a technique called \"TCP\nFast Open (TFO)\" but this is an extension and not the normal behaviour. In a\nstandard three-way handshake, the first SYN carries 0 bytes of application data.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: TCP doea allow a SYN segment to include data, a technique called \"TCP Fast Open (TFO)\" but this is an extension and not the normal behaviour. In a standard three-way handshake, the first SYN carries 0 bytes of application data.",
      "autoResize": false,
      "lineHeight": 1.25
    },
