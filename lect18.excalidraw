      "index": "cHtN",
      "roundness": null,
      "seed": 1697297032,
      "version": 111,
      "versionNonce": 995799432,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785230681594,
      "link": null,
      "locked": false,
      "text": "TCP is stateful because it maintains the state of each connection (using a 3-way handshake),\ntracks sequence numbers, acknowledgments, and connection status throughout the communication.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TCP is stateful because it maintains the state of each connection (using a 3-way handshake), tracks sequence numbers, acknowledgments, and connection status throughout the communication.",
      "autoResize": false,
      "lineHeight": 1.25
    }
