      "isDeleted": false,
      "boundElements": [],
      "updated": 1785228333543,
      "link": null,
      "locked": false,
      "text": "and if any segment drops in between then TCP retransmeet it unlike UDP",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "and if any segment drops in between then TCP retransmeet it unlike UDP",
      "autoResize": true,
