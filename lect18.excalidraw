      "text": "Kuch states hai jo wo manage kar rhe hai on the host machine that's why this is stateful protocol",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kuch states hai jo wo manage kar rhe hai on the host machine that's why this is stateful protocol",
