      "link": null,
      "locked": false,
      "text": "NOTE: Source Destination Length and Checksum are all continuous bits(0 or 1) and there is no rows concept there so after Destination port in same row Length continues",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: Source Destination Length and Checksum are all continuous bits(0 or 1) and there is no rows concept there so after Destination port in same row Length continues",
      "autoResize": true,
      "lineHeight": 1.25
    },
