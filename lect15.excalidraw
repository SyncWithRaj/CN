    {
      "id": "d1QvY2xVnkRv2lZrJ0oTk",
      "type": "text",
      "x": 453.75456338521826,
      "y": 496.7228206351514,
      "width": 1004.0589599609375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
