      "isDeleted": true,
      "boundElements": [],
      "updated": 1784886815708,
      "link": null,
      "locked": false,
      "text": "Apart from ICMP being blocked or disabeld, routers may also NOT send an ICMP TTL, Exceeded reply due to rate limiting, congestion, packet loss, or timeout etc,",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apart from ICMP being blocked or disabeld, routers may also NOT send an ICMP TTL, Exceeded reply due to rate limiting, congestion, packet loss, or timeout etc,",
      "autoResize": true,
      "lineHeight": 1.25
    }
