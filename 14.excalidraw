    {
      "id": "8s-uNKC_tK5sVifq7N5zV",
      "type": "text",
      "x": 1284.3469618683537,
      "y": 3739.390180556101,
      "width": 1542.918701171875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cGJW",
      "roundness": null,
      "seed": 1119343070,
      "version": 878,
      "versionNonce": 1837229080,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784886815708,
      "link": null,
      "locked": false,
      "text": "trace route kya karega ki pehle TTL ko 1 set kar dega then pehla hi router usko TTL=0 kar dega so wo req drop kar dega and replly dega ki TTL Exceeded \nso now ab traceroute TTL=2 set karega then Router(20.0.0.1) usko 1 se 0 kar dega then wo useko wahi reply eror  send karega TTLExceeded then\nsource firse TTL k increment karega to TTL=3 then wo e step  aage badhega \nese karte karte TTL=6 me wo google.com reah ho jaayega so then google.com usko reply karega \n\nso that's why TTL is most imp  thing\n\naur yahi step ki wajah se Traceroute bhi imp hai wo pura route trace krta hai hi hop lete lete req konse router se konse router me gayi... \n\nIt trace the whle path(route) fromm source to detination",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "trace route kya karega ki pehle TTL ko 1 set kar dega then pehla hi router usko TTL=0 kar dega so wo req drop kar dega and replly dega ki TTL Exceeded \nso now ab traceroute TTL=2 set karega then Router(20.0.0.1) usko 1 se 0 kar dega then wo useko wahi reply eror  send karega TTLExceeded then\nsource firse TTL k increment karega to TTL=3 then wo e step  aage badhega \nese karte karte TTL=6 me wo google.com reah ho jaayega so then google.com usko reply karega \n\nso that's why TTL is most imp  thing\n\naur yahi step ki wajah se Traceroute bhi imp hai wo pura route trace krta hai hi hop lete lete req konse router se konse router me gayi... \n\nIt trace the whle path(route) fromm source to detination",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IGHjft66h3z1iJBNt-nGJ",
      "type": "text",
      "x": 958.5539319004521,
      "y": 3446.9456285910587,
      "width": 344.5796813964844,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cGJX",
      "roundness": null,
      "seed": 394928002,
      "version": 219,
      "versionNonce": 252709224,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784886815708,
      "link": null,
      "locked": false,
      "text": "1st hop -> 10.0.0.4\n2nd hop -> 20.0.0.1\n3rd hop -> 30.0.0.1\n4th hop -> 40.0.0.1\n5th hop -> 50.0.0.1\nEnd - I reached to the destination",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1st hop -> 10.0.0.4\n2nd hop -> 20.0.0.1\n3rd hop -> 30.0.0.1\n4th hop -> 40.0.0.1\n5th hop -> 50.0.0.1\nEnd - I reached to the destination",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pEMBlgUZUfnqy4ecLbtGN",
      "type": "text",
      "x": 1464.6761653794301,
      "y": 4151.003833599505,
      "width": 47.49995422363281,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
